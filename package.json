{
  "version": "0.0.28",
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@calcit/procs": "0.19.1"
  },
  "scripts": {
    "test:calcit": "calcit calcit.cirru --entry test",
    "test:js": "calcit calcit.cirru --entry test js && node test.mjs",
    "test:wasm:compile": "calcit wasm calcit.cirru --entry test --init-fn bisection-key.wasm-probe/probe-all-count",
    "test:wasm": "yarn test:wasm:compile && node wasm-test.mjs"
  }
}
